FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
COPY packages/db/package.json packages/db/
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
RUN npm ci --workspace @sgee/shared --workspace @sgee/ui --workspace @sgee/web --include-workspace-root
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/ui packages/ui
COPY apps/web apps/web
ARG NEXT_PUBLIC_API_WS_URL=http://localhost:4000
# Rewrites (/api/v1 → API) are resolved at build time: point them to the API service.
ARG API_INTERNAL_URL=http://api:4000
ENV NEXT_PUBLIC_API_WS_URL=$NEXT_PUBLIC_API_WS_URL API_INTERNAL_URL=$API_INTERNAL_URL
RUN npm run build -w @sgee/shared && cd apps/web && npx next build

FROM node:22-alpine
ENV NODE_ENV=production TZ=America/Bogota
WORKDIR /app
COPY --from=build /app /app
WORKDIR /app/apps/web
USER node
EXPOSE 3100
CMD ["node", "/app/node_modules/next/dist/bin/next", "start", "-p", "3100"]
