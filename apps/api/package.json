{
  "name": "@sgee/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e ../../.env -- concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch-path=dist --enable-source-maps scripts/wait-and-run.js\"",
    "start": "dotenv -e ../../.env -- node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "dotenv -e ../../.env -- vitest",
    "phidias:sync": "dotenv -e ../../.env -- node dist/cli/phidias-sync.js",
    "openapi": "dotenv -e ../../.env -- node dist/cli/openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@nestjs/common": "11.2.4",
    "@nestjs/core": "11.2.4",
    "@nestjs/platform-express": "11.2.4",
    "@nestjs/platform-socket.io": "11.2.4",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "12.0.1",
    "@sgee/db": "1.0.0",
    "@sgee/shared": "1.0.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.4",
    "@swc/core": "^1.12.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.0",
    "dotenv-cli": "^8.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1",
    "unplugin-swc": "^1.5.5",
    "vitest": "3.2.4",
    "@vitest/coverage-v8": "3.2.4"
  }
}
