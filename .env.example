# ── Base de datos ───────────────────────────────────────────────────────────
# Superusuario: solo para crear BD/rol y aplicar migraciones.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sgee
# Rol de la aplicación (NO superusuario → RLS aplica).
DATABASE_URL=postgresql://sgee_app:CHANGE_ME_APP@localhost:5432/sgee
DB_APP_PASSWORD=CHANGE_ME_APP
# Base de datos de pruebas
TEST_DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sgee_test
TEST_DATABASE_URL=postgresql://sgee_app:CHANGE_ME_APP@localhost:5432/sgee_test

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3100
PUBLIC_WEB_URL=http://localhost:3100
TZ=America/Bogota
JWT_SECRET=change-me-64-random-chars
# Clave AES-256 (32 bytes base64) para cifrado de columnas y archivos
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Expone OTP en respuestas SOLO en desarrollo/pruebas
DEV_EXPOSE_OTP=true
JOBS_ENABLED=true

# ── Phidias ─────────────────────────────────────────────────────────────────
PHIDIAS_BASE_URL=https://ds-barranquilla.phidias.co/rest
PHIDIAS_TOKEN=
PHIDIAS_MOCK=false
POLL_ID_ENFERMERIA=114
POLL_ID_ENFERMERIA_COLAB=113
# Acudientes y contactos de emergencia (requiere permisos Person_Relative_Controller::getRelatives y people/details)
PHIDIAS_RELATIVES_ENDPOINT=/1/people/relatives
PHIDIAS_RELATIVES_PARAM=personId

# ── Archivos (fotos en S3, adjuntos locales cifrados o S3) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_PHOTOS_BUCKET=enfermeriacaleman
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ATTACHMENTS_BUCKET=
S3_ATTACHMENTS_PREFIX=sgee/

# ── Notificaciones ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Enfermería <enfermeria@colegio.edu.co>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:enfermeria@colegio.edu.co

# ── Colegio real: dominio y administrador institucional (seed) ──────────────
SCHOOL_EMAIL_DOMAIN=colegio.edu.co
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_WS_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# URL pública del sitio (canonical, sitemap, Open Graph)
PUBLIC_SITE_URL=http://localhost:3100
