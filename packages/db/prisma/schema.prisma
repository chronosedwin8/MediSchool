// MediSchool (SGEE) — PostgreSQL schema. See PLAN.md §7.
// Conventions: uuid PKs, tenant_id on every business table (RLS in
// migrations/*_rls), snake_case columns, created_at/updated_at, no DELETE on
// clinical/meds/audit (triggers). States are text + CHECK constraints.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_ADMIN_URL")
  extensions = [pgcrypto, pg_trgm, citext, uuid_ossp(map: "uuid-ossp")]
  schemas    = ["core", "people", "clinical", "meds", "inventory", "flow", "comms", "compliance", "audit", "integration"]
}

// ════════════════════════════════════════════════════════════════════ core ══

model Tenant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  country     String   @default("CO")
  timezone    String   @default("America/Bogota")
  settings    Json     @default("{}")
  logoUrl     String?  @map("logo_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
  @@schema("core")
}

model Campus {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("campuses")
  @@schema("core")
}

model AcademicYear {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  startsOn   DateTime @map("starts_on") @db.Date
  endsOn     DateTime @map("ends_on") @db.Date
  current    Boolean  @default(false)
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, name])
  @@map("academic_years")
  @@schema("core")
}

model Section {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  code       String
  sortOrder  Int      @default(0) @map("sort_order")
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  grades     Grade[]

  @@unique([tenantId, code])
  @@map("sections")
  @@schema("core")
}

model Grade {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  sectionId  String   @map("section_id") @db.Uuid
  name       String
  code       String
  sortOrder  Int      @default(0) @map("sort_order")
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  section    Section  @relation(fields: [sectionId], references: [id])
  groups     Group[]

  @@unique([tenantId, code])
  @@index([sectionId])
  @@map("grades")
  @@schema("core")
}

model Group {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  gradeId        String         @map("grade_id") @db.Uuid
  academicYearId String?        @map("academic_year_id") @db.Uuid
  name           String
  code           String
  homeroomUserId String?        @map("homeroom_user_id") @db.Uuid
  externalId     String?        @map("external_id")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  grade          Grade          @relation(fields: [gradeId], references: [id])
  students       Student[]
  teachers       TeacherGroup[]
  scheduleBlocks ScheduleBlock[]

  @@unique([tenantId, code])
  @@index([gradeId])
  @@map("groups")
  @@schema("core")
}

model Period {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid
  name           String
  startsOn       DateTime @map("starts_on") @db.Date
  endsOn         DateTime @map("ends_on") @db.Date
  externalId     String?  @map("external_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("periods")
  @@schema("core")
}

model CalendarDay {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  date        DateTime @db.Date
  kind        String   @default("SCHOOL_DAY")
  description String?

  @@unique([tenantId, date])
  @@map("calendar_days")
  @@schema("core")
}

model ScheduleBlock {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  groupId       String  @map("group_id") @db.Uuid
  dayOfWeek     Int     @map("day_of_week")
  startTime     String  @map("start_time")
  endTime       String  @map("end_time")
  subject       String
  teacherUserId String? @map("teacher_user_id") @db.Uuid
  group         Group   @relation(fields: [groupId], references: [id])

  @@index([tenantId, groupId, dayOfWeek])
  @@map("schedule_blocks")
  @@schema("core")
}

model User {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  email              String                  @db.Citext
  passwordHash       String?                 @map("password_hash")
  firstName          String                  @map("first_name")
  lastName           String                  @map("last_name")
  phone              String?
  personId           String?                 @map("person_id") @db.Uuid
  active             Boolean                 @default(true)
  locale             String                  @default("es-CO")
  mustChangePassword Boolean                 @default(false) @map("must_change_password")
  failedLogins       Int                     @default(0) @map("failed_logins")
  lockedUntil        DateTime?               @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?               @map("last_login_at") @db.Timestamptz(6)
  kioskDeviceCode    String?                 @map("kiosk_device_code")
  kioskPinHash       String?                 @map("kiosk_pin_hash")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?                 @map("created_by") @db.Uuid
  roles              UserRole[]
  sessions           Session[]
  mfaDevices         MfaDevice[]
  teacherGroups      TeacherGroup[]
  person             Person?                 @relation(fields: [personId], references: [id])
  notifications      Notification[]
  preference         NotificationPreference?

  @@unique([tenantId, email])
  @@index([personId])
  @@map("users")
  @@schema("core")
}

model RoleDef {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  label       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@map("roles")
  @@schema("core")
}

model PermissionDef {
  key         String @id
  description String?

  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  roleKey       String   @map("role_key")
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, roleKey, permissionKey])
  @@map("role_permissions")
  @@schema("core")
}

model UserRole {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String
  scopeSectionId String?  @map("scope_section_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, role, scopeSectionId])
  @@index([tenantId])
  @@map("user_roles")
  @@schema("core")
}

model TeacherGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  subject   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@index([tenantId])
  @@map("teacher_groups")
  @@schema("core")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  kiosk            Boolean   @default(false)
  ip               String?
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@map("sessions")
  @@schema("core")
}

model MfaDevice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String    @default("TOTP")
  secretEnc   String    @map("secret_enc")
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@map("mfa_devices")
  @@schema("core")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid

  @@index([tenantId])
  @@map("api_keys")
  @@schema("core")
}

model IdempotencyKey {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  key          String
  method       String
  path         String
  requestHash  String   @map("request_hash")
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, userId, key])
  @@map("idempotency_keys")
  @@schema("core")
}

model LinkToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  purpose   String
  tokenHash String    @unique @map("token_hash")
  subjectId String    @map("subject_id") @db.Uuid
  personId  String?   @map("person_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  maxUses   Int       @default(1) @map("max_uses")
  uses      Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, subjectId])
  @@map("link_tokens")
  @@schema("core")
}

model Invitation {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  code         String    @unique
  studentId    String    @map("student_id") @db.Uuid
  relationship String
  email        String?   @db.Citext
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  usedByUserId String?   @map("used_by_user_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid

  @@index([tenantId, studentId])
  @@map("invitations")
  @@schema("core")
}

model StoredFile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  storageKey    String   @unique @map("storage_key")
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  size          Int
  sha256        String
  kind          String
  driver        String   @default("local")
  encrypted     Boolean  @default(true)
  scanStatus    String   @default("SKIPPED") @map("scan_status")
  ownerPersonId String?  @map("owner_person_id") @db.Uuid
  expiresOn     DateTime? @map("expires_on") @db.Date
  uploadedBy    String?  @map("uploaded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, ownerPersonId])
  @@map("files")
  @@schema("core")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId])
  @@map("push_subscriptions")
  @@schema("core")
}

model ScheduledReport {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  kind       String
  frequency  String
  recipients String[]
  params     Json      @default("{}")
  lastRunAt  DateTime? @map("last_run_at") @db.Timestamptz(6)
  active     Boolean   @default(true)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("scheduled_reports")
  @@schema("core")
}

// ══════════════════════════════════════════════════════════════════ people ══

model Person {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  kind           String
  documentType   String?           @map("document_type")
  documentNumber String?           @map("document_number")
  firstName      String            @map("first_name")
  lastName       String            @map("last_name")
  birthDate      DateTime?         @map("birth_date") @db.Date
  sex            String?
  email          String?           @db.Citext
  phone          String?
  mobile         String?
  address        String?
  nationality    String?
  photoKey       String?           @map("photo_key")
  photoHash      String?           @map("photo_hash")
  source         String            @default("LOCAL")
  status         String            @default("ACTIVE")
  inactiveReason String?           @map("inactive_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?           @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid
  student        Student?
  guardian       Guardian?
  staff          Staff?
  users          User[]
  contacts       Contact[]
  addresses      Address[]
  healthProfile  HealthProfile?
  allergies      Allergy[]
  conditions     ChronicCondition[]
  encounters     Encounter[]

  @@index([tenantId, kind])
  @@index([tenantId, documentNumber])
  @@map("persons")
  @@schema("people")
}

model Student {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  personId         String             @unique @map("person_id") @db.Uuid
  code             String
  currentGroupId   String?            @map("current_group_id") @db.Uuid
  enrollmentStatus String?            @map("enrollment_status")
  shift            String?
  transport        String?
  status           String             @default("ACTIVE")
  inactiveReason   String?            @map("inactive_reason")
  externalId       String?            @map("external_id")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  person           Person             @relation(fields: [personId], references: [id])
  group            Group?             @relation(fields: [currentGroupId], references: [id])
  guardians        StudentGuardian[]
  emergencyContacts EmergencyContact[]
  enrollments      Enrollment[]
  passes           Pass[]
  medicationRequests MedicationRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, currentGroupId])
  @@map("students")
  @@schema("people")
}

model Guardian {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  personId   String            @unique @map("person_id") @db.Uuid
  occupation String?
  company    String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  person     Person            @relation(fields: [personId], references: [id])
  students   StudentGuardian[]

  @@index([tenantId])
  @@map("guardians")
  @@schema("people")
}

model StudentGuardian {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  guardianId          String   @map("guardian_id") @db.Uuid
  relationship        String
  isPrimary           Boolean  @default(false) @map("is_primary")
  canPickUp           Boolean  @default(true) @map("can_pick_up")
  legalCustody        Boolean  @default(true) @map("legal_custody")
  priority            Int      @default(1)
  restrictions        String?
  judicialRestriction Boolean  @default(false) @map("judicial_restriction")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  student             Student  @relation(fields: [studentId], references: [id])
  guardian            Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([tenantId, guardianId])
  @@map("student_guardians")
  @@schema("people")
}

model Staff {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  personId         String   @unique @map("person_id") @db.Uuid
  position         String?
  sectionId        String?  @map("section_id") @db.Uuid
  isTeacher        Boolean  @default(false) @map("is_teacher")
  isFirstResponder Boolean  @default(false) @map("is_first_responder")
  externalId       String?  @map("external_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  person           Person   @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@map("staff")
  @@schema("people")
}

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  type      String
  value     String
  verified  Boolean  @default(false)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person    Person   @relation(fields: [personId], references: [id])

  @@index([tenantId, personId])
  @@map("contacts")
  @@schema("people")
}

model Address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  personId     String   @map("person_id") @db.Uuid
  line1        String
  neighborhood String?
  city         String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person       Person   @relation(fields: [personId], references: [id])

  @@index([tenantId, personId])
  @@map("addresses")
  @@schema("people")
}

model EmergencyContact {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  name           String
  relationship   String
  phone          String
  altPhone       String?   @map("alt_phone")
  canPickUp      Boolean   @default(false) @map("can_pick_up")
  documentNumber String?   @map("document_number")
  notes          String?
  verified       Boolean   @default(false)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  active         Boolean   @default(true)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  student        Student   @relation(fields: [studentId], references: [id])

  @@index([tenantId, studentId])
  @@map("emergency_contacts")
  @@schema("people")
}

model Enrollment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
